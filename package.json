  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--experimental-require-module nuxi dev",
    "build": "cross-env NODE_OPTIONS=--experimental-require-module nuxi build",
    "generate": "cross-env NODE_OPTIONS=--experimental-require-module nuxi generate && mkdirp .tauri-build/dist && copyfiles -u 2 \".output/public/**/*\" .tauri-build/dist",
