    "dlnode": "npx tsx scripts/dlnode.ts",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "vitest",
    "test-e2e": "playwright test",
    "clean": "del-cli --force dist dev-dist coverage .output .nuxt src-tauri/target .tauri-build pnpm-lock.yaml",
    "nuke": "pnpm clean && del-cli --force dist node_modules",
    "check-types": "tsc --noEmit",
    "lint": "eslint",
    "format": "prettier . --write",
    "format-check": "prettier . --check",
    "depcheck": "depcheck"
